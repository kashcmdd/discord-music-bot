# Discord Bot
BOT_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here

# Spotify API (optional — for Spotify URL resolution)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Genius API (optional — for lyrics)
GENIUS_TOKEN=your_genius_api_token

# Dashboard (optional — for web UI)
DASHBOARD_PORT=3000
DASHBOARD_SECRET=a_long_random_secret_string
DISCORD_REDIRECT_URI=http://localhost:3000/auth/callback
DASHBOARD_CLIENT_ID=your_client_id_here
DASHBOARD_CLIENT_SECRET=your_dashboard_client_secret

# Audit log channel (optional — logs tier changes here)
AUDIT_LOG_CHANNEL_ID=
